---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import { getPersonalProjects } from '@/lib/projects';
import { resolveGallery } from '@/lib/image';

export const getStaticPaths = (async () => {
  const projects = await getPersonalProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content, headings } = await render(project);
const gallery = await resolveGallery(project);
---

<CaseStudyLayout project={project} headings={headings} gallery={gallery}>
  {/* The phone screens reach <AppScreens /> inside the MDX as `props.gallery`. */}
  <Content gallery={gallery} />
</CaseStudyLayout>
