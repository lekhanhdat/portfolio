---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PersonalProjectsIndex } from '@/components/sections/PersonalProjectsIndex';
import { getPersonalProjects } from '@/lib/projects';
import { resolveShowcase } from '@/lib/image';
import { profile } from '@/data/profile';

const projects = await getPersonalProjects();
const showcases = Object.fromEntries(
  await Promise.all(projects.map(async (project) => [project.id, await resolveShowcase(project)])),
);
---

<BaseLayout
  title={`Personal projects — ${profile.name}`}
  description="Products Le Khanh Dat built end to end, including an AI-assisted travel platform for Da Nang."
>
  <PersonalProjectsIndex projects={projects} showcases={showcases} />
</BaseLayout>
