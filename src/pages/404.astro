---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/with-base';
---

<BaseLayout
  title="Page not found — Le Khanh Dat"
  description="The requested page does not exist."
  canonical={false}
>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center px-6 py-24">
    <p class="font-mono text-xs tracking-[0.08em] text-text-muted uppercase">Error 404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-6 text-lg text-text-muted">
      The page you are looking for does not exist or has moved.
    </p>
    <p class="mt-10">
      <a href={withBase('/')} class="font-medium text-accent underline-offset-4 hover:underline">
        Back to home
      </a>
    </p>
  </main>
</BaseLayout>
