---
// Company project brief (PLAN §4.4 A), three screens: the header here, then the two
// .page-section groups of the MDX file (the last one renders BriefFooter itself, with the
// prev/next links the page passes to <Content />). No Astro markup goes into React.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BriefHeader } from '@/components/projects/BriefHeader';
import type { CompanyProject } from '@/lib/projects';
import { profile } from '@/data/profile';
import { projectJsonLd } from '@/lib/seo';
import { companyProjectPath } from '@/lib/projects';

interface Props {
  project: CompanyProject;
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.data.title} — ${profile.name}`}
  description={project.data.summary}
  type="article"
  snap
  jsonLd={[
    projectJsonLd({
      title: project.data.title,
      summary: project.data.summary,
      path: companyProjectPath(project.id),
      keywords: project.data.stack,
    }),
  ]}
>
  <!-- Same classes as <Container>: the slot holds Astro markup, which must not go into React. -->
  <article class="mx-auto w-full max-w-page px-5 sm:px-8 lg:px-12">
    <div class="page-section">
      <BriefHeader project={project} />
    </div>
    <div class="prose-content">
      <slot />
    </div>
  </article>
</BaseLayout>
