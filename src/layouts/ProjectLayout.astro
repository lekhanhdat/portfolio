---
// Company project brief (PLAN §4.4 A). MDX content renders in the slot between the
// React header and footer, so no Astro markup is ever passed into a React component.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BriefHeader } from '@/components/projects/BriefHeader';
import { BriefFooter } from '@/components/projects/BriefFooter';
import type { PagerLink } from '@/components/projects/PrevNextNav';
import type { CompanyProject } from '@/lib/projects';
import { profile } from '@/data/profile';

interface Props {
  project: CompanyProject;
  prev?: PagerLink;
  next?: PagerLink;
}

const { project, prev, next } = Astro.props;
---

<BaseLayout title={`${project.data.title} — ${profile.name}`} description={project.data.summary}>
  <!-- Same classes as <Container>: the slot holds Astro markup, which must not go into React. -->
  <article class="mx-auto w-full max-w-page px-5 py-10 sm:px-8 lg:px-12 lg:py-16">
    <BriefHeader project={project} />
    <div class="prose-content mt-14">
      <slot />
    </div>
    <BriefFooter stack={project.data.stack} prev={prev} next={next} />
  </article>
</BaseLayout>
