---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { withBase } from '@/lib/with-base';
import { SkipLink } from '@/components/layout/SkipLink';
import { SiteHeader } from '@/components/layout/SiteHeader';
import { SiteFooter } from '@/components/layout/SiteFooter';
import Seo from '@/components/seo/Seo.astro';

interface Props {
  title: string;
  description: string;
  /** Keep a page out of search results (404, internal styleguide). */
  noindex?: boolean;
  /** Error pages have no canonical URL. */
  canonical?: boolean;
  /** Section links in the header; hidden on pages that stand outside the site flow. */
  showNav?: boolean;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: readonly Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  canonical: hasCanonical = true,
  showNav = true,
  type,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      noindex={noindex}
      canonical={hasCanonical}
      type={type}
      jsonLd={jsonLd}
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />

    <!-- Apply the theme before first paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Storage blocked: fall back to the OS preference below.
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
      })();
    </script>
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body id="top" class="flex min-h-dvh flex-col bg-bg text-text antialiased">
    <SkipLink />
    <SiteHeader currentPath={Astro.url.pathname} showNav={showNav} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '@/scripts/theme';
      import '@/scripts/header';
      import '@/scripts/mobile-nav';
      import '@/scripts/reveal';
      import '@/scripts/active-section';
      import '@/scripts/copy-email';
    </script>
  </body>
</html>
